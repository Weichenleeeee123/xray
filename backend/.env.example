# 复制为 backend/.env 再填（.env 已被 git 忽略，不要提交 Key）
# 比赛 Tokendance 网关，OpenAI 兼容；BASE_URL 写到 /v1 这一级，程序会拼 /chat/completions
TOKENDANCE_BASE_URL=https://tokendance.space/gateway/v1
TOKENDANCE_API_KEY=
# 实测见 docs/tokendance.md
TOKENDANCE_MODEL=qwen3.8-max
# 看图用的模型，不填就用上面那个
TOKENDANCE_VISION_MODEL=qwen3.8-max
# Qwen3.8-Max 已在线验证 response_format=json_object；仍执行服务端 Schema 校验
TOKENDANCE_JSON_MODE=1
# 0=关闭长思考（默认），1=开启，留空=不传该参数；修改后重启服务
TOKENDANCE_ENABLE_THINKING=0
TOKENDANCE_TIMEOUT=45
# 问答及格式/事实重写共享预算（秒）；不截断材料、不自动增加重写次数。
XRAY_CHAT_TIMEOUT=60

# 小企案卷记忆：首次发布保留 full；shadow 只测检索覆盖，不增加模型调用。
# 验收后启用：XRAY_CASE_MEMORY_ENABLED=1 + XRAY_ASSISTANT_CONTEXT_MODE=selective
# selective 表示完整保存原文、按需读取，不是每轮全量输入。
XRAY_CASE_MEMORY_ENABLED=0
XRAY_ASSISTANT_CONTEXT_MODE=full
# 生产建议 /var/lib/qier/case_memory；必须在所有公开静态目录之外。
# XRAY_CASE_MEMORY_DIR=
# 本地字符防护，不代表 Tokendance 的 token 上限；还需预留系统/schema/重写空间。
XRAY_ASSISTANT_CONTEXT_CHARS=240000
XRAY_ASSISTANT_EVIDENCE_CHARS=70000
# 发布时填写实际提交号；只用于健康接口确认部署版本，不自动切换模型。
XRAY_RELEASE_ID=
# 生产建议 /var/lib/qier/private，需跨版本保留；签名文件变化会使已有访客身份失效。
# XRAY_PRIVATE_DIR=/var/lib/qier/private
# 前后端同域无需配置。分离开发时列出完整、可信的前端 origin，勿使用 *。
XRAY_ALLOWED_ORIGINS=

# live：调网关并录下响应，失败时回放录音；replay：只回放（断网演示）；off：不调模型，全走规则和模板
XRAY_LLM_MODE=live

# 企业公开信息扩搜：有现有网关搜索权限时默认开启；0 回退固定三路搜索。
# 不更换模型/密钥，不搜索用户材料；新增资料不作为新增风险计数。
XRAY_WEB_DISCOVERY=1
XRAY_WEB_DISCOVERY_QUERIES=10
XRAY_WEB_DISCOVERY_ROUNDS=2
XRAY_WEB_DISCOVERY_WORKERS=3
XRAY_WEB_DISCOVERY_SECONDS=35
XRAY_WEB_DISCOVERY_READS=8
XRAY_WEB_DISCOVERY_HOST_READS=3
XRAY_WEB_DISCOVERY_SEARCH_TIMEOUT=10
XRAY_WEB_DISCOVERY_READ_TIMEOUT=8
# 仅限制新抓取的公开网页摘录；超出标 partial，不裁剪用户材料或已有案卷。
XRAY_WEB_DISCOVERY_PAGE_CHARS=12000
# 现有模型只提出带原文依据的关联候选；失败自动用确定性模板继续搜索。
XRAY_WEB_DISCOVERY_LLM=1

# 商业数据接口（按次计费；有效期内读缓存，过期或主动刷新会再次查询并可能计费）
# 填 qcc_agent（企查查智能体数据平台，个人可注册，推荐）、qcc（企查查开放平台）或 tianyancha（天眼查）；不填就不用
XRAY_COMMERCIAL=
QCC_APP_KEY=
QCC_SECRET_KEY=
TIANYANCHA_TOKEN=
# 每个服务进程最多实际调用几次（缓存命中不算；重启重新计数）
XRAY_COMMERCIAL_MAX_CALLS=30

# 企查查智能体数据平台 agent.qcc.com：个人中心复制 API Key（不带 Bearer）。结果缓存在 data/cache/qcc_agent/
QCC_AGENT_KEY=
# 多个 Key 用逗号隔开：QCC_AGENT_KEY=key1,key2,key3。当前的失效、积分用完或被限流，自动换下一个
# 每个服务进程最多实际花多少积分（缓存命中不算；重启重新计数）
XRAY_QCC_MAX_POINTS=1500

# 商业缓存有效期，单位秒；0 表示每次重查。请求 refresh_sources=true 可主动刷新。
XRAY_COMMERCIAL_CACHE_TTL=86400
# 每个服务进程同时运行的建案/补充研究任务上限，满载返回 503。
XRAY_MAX_RUNS=4
