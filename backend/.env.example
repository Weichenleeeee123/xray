# 复制为 backend/.env 再填（.env 已被 git 忽略，不要提交 Key）
# 比赛 Tokendance 网关，OpenAI 兼容；BASE_URL 写到 /v1 这一级，程序会拼 /chat/completions
TOKENDANCE_BASE_URL=https://tokendance.space/gateway/v1
TOKENDANCE_API_KEY=
# 实测见 docs/tokendance.md
TOKENDANCE_MODEL=qwen3.8-max
# 看图用的模型，不填就用上面那个
TOKENDANCE_VISION_MODEL=qwen3.8-max
# Qwen3.8-Max 已在线验证 response_format=json_object；仍执行服务端 Schema 校验
TOKENDANCE_JSON_MODE=1
# 0=关闭长思考（默认），1=开启，留空=不传该参数；修改后重启服务
TOKENDANCE_ENABLE_THINKING=0
TOKENDANCE_TIMEOUT=45

# live：调网关并录下响应，失败时回放录音；replay：只回放（断网演示）；off：不调模型，全走规则和模板
XRAY_LLM_MODE=live

# 商业数据接口（按次计费，结果缓存在 data/cache/commercial/，不会重复扣费）
# 填 qcc_agent（企查查智能体数据平台，个人可注册，推荐）、qcc（企查查开放平台）或 tianyancha（天眼查）；不填就不用
XRAY_COMMERCIAL=
QCC_APP_KEY=
QCC_SECRET_KEY=
TIANYANCHA_TOKEN=
# 单次运行最多实际调用几次（缓存命中不算）
XRAY_COMMERCIAL_MAX_CALLS=30

# 企查查智能体数据平台 agent.qcc.com：个人中心复制 API Key（不带 Bearer）。结果缓存在 data/cache/qcc_agent/
QCC_AGENT_KEY=
# 单次运行最多实际花多少积分（缓存命中不算）；平台对同一家公司每月最多扣 100 积分
XRAY_QCC_MAX_POINTS=300
